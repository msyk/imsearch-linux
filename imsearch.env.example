# imsearch の設定（cp imsearch.env.example imsearch.env して編集）
# 実際の環境変数が設定されていればそちらが優先されます。

# --- LLM サーバー ---
#IMSEARCH_LLM_API=ollama                 # openai にすると OpenAI 互換 API（/v1/...）
#IMSEARCH_LLM_BASE_URL=http://localhost:11434
#IMSEARCH_LLM_API_KEY=                   # OpenAI 互換 API のキー（Bearer）

# --- モデル（既定はメモリ 2GB 向け） ---
#IMSEARCH_CHAT_MODEL=qwen3:1.7b          # 余裕があれば qwen3:4b（約2.5GB。README 参照）
#IMSEARCH_EMBED_MODEL=qwen3-embedding:0.6b
#IMSEARCH_EMBED_DIM=1024                 # 埋め込みモデルを変えたら索引を作り直す

# --- メモリ関連 ---
#IMSEARCH_NUM_CTX=4096                   # 回答生成のコンテキスト長（KV キャッシュの大きさ）
#IMSEARCH_NUM_PREDICT=1024               # 回答の最大トークン数（入力＋回答が NUM_CTX に収まること）
#IMSEARCH_USE_MMAP=1                     # モデルファイルをメモリマップで読む（RAM 使用量が約 280MB 減る）
#IMSEARCH_CONTEXT_CHUNKS=4               # LLM に渡す資料の数
#IMSEARCH_CONTEXT_CHARS=3500             # LLM に渡す資料の合計文字数（NUM_CTX に収まる量）
#IMSEARCH_PREREQ_KEYS=3                  # 上位のサンプルが使う設定について、マニュアルの説明を加える数（0 で無効）
#IMSEARCH_PREREQ_CHARS=1000              # その説明に使う文字数（CONTEXT_CHARS の内数）
#IMSEARCH_EMBED_BATCH=4
#IMSEARCH_SQLITE_CACHE_KB=8192
#IMSEARCH_KEEP_ALIVE=10m                 # 0 にすると毎回モデルを解放（省メモリだが遅い）
#IMSEARCH_LLM_TIMEOUT=900
#IMSEARCH_NUM_THREAD=0                   # Ollama の CPU スレッド数。0=自動（コンテナの CPU 制限も検出）

# --- 検索 ---
#IMSEARCH_ANALYZE_JA=0                   # 1 で日本語の質問にも LLM のクエリ解析を使う（遅くなる）
#IMSEARCH_ANALYZE_MODE=simple            # json: 翻訳＋検索語＋識別子を JSON で出させる（大きいモデル向け。Mac 版の動作）

# --- Web アプリ（imsearch serve） ---
#IMSEARCH_WEB_HOST=127.0.0.1             # 公開は nginx・Apache の後ろで（deploy/ の設定例）
#IMSEARCH_WEB_PORT=8000
#IMSEARCH_WEB_CONCURRENCY=1              # 同時に生成する回答数（2〜4GB では 1）
#IMSEARCH_WEB_MAX_QUEUE=2                # 順番待ちの上限。超えると「混み合っています」
#IMSEARCH_WEB_MAX_QUESTION=500           # 質問の最大文字数
#IMSEARCH_WEB_ASK_PER_MIN=0              # IP ごとの 1 分あたりの回答数の上限（0 = なし。Apache で公開するなら 6 など）
#IMSEARCH_WEB_ROOT_PATH=                 # サブパスで公開するとき（例: /imsearch。deploy/apache-imsearch-subpath.conf）

# --- パス ---
#IMSEARCH_DATA_DIR=./data
#IMSEARCH_DB=./data/imsearch.db

# --- メモリ 4GB 以上のとき（回答に使う資料を増やす。下の行のコメントを外す） ---
# Ollama 側も deploy/ollama-override.conf の OLLAMA_MAX_LOADED_MODELS=2、MemoryHigh=3000M、MemoryMax=3500M に変える
#IMSEARCH_NUM_CTX=8192
#IMSEARCH_CONTEXT_CHUNKS=5
#IMSEARCH_CONTEXT_CHARS=7000
#IMSEARCH_PREREQ_KEYS=4
#IMSEARCH_PREREQ_CHARS=2000
#IMSEARCH_EMBED_BATCH=8

# --- LLM をさくらのクラウド「さくらの AI Engine」で使うとき（メモリ 1GB 可。setup の --profile api） ---
# 下の行のコメントを外し、API キー（コントロールパネルのアカウントトークン <UUID>:<シークレット>）を入れる。
# 埋め込みモデルが変わるので、索引は作り直す（imsearch ingest。埋め込みも API で行うので GPU 不要）。
# 上の「メモリ 4GB 以上のとき」とは同時に使わない。
#IMSEARCH_LLM_API=openai
#IMSEARCH_LLM_BASE_URL=https://api.ai.sakura.ad.jp
#IMSEARCH_LLM_API_KEY=
#IMSEARCH_CHAT_MODEL=gpt-oss-120b
#IMSEARCH_EMBED_MODEL=multilingual-e5-large
#IMSEARCH_EMBED_DIM=1024
# e5 は 512 トークンまで（日本語 800 字でほぼ収まる。超えた分は自動で短くして再送）。32 件ずつで索引の作成は約 170 リクエスト。
#IMSEARCH_EMBED_MAX_CHARS=800
#IMSEARCH_EMBED_BATCH=32
#IMSEARCH_NUM_PREDICT=4096
#IMSEARCH_REASONING_EFFORT=low
#IMSEARCH_CONTEXT_CHUNKS=8
#IMSEARCH_CONTEXT_CHARS=16000
#IMSEARCH_PREREQ_KEYS=4
#IMSEARCH_PREREQ_CHARS=2000
#IMSEARCH_LLM_TIMEOUT=180
#IMSEARCH_WEB_CONCURRENCY=2
#IMSEARCH_WEB_MAX_QUEUE=4
